<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.voxnote"
    android:versionCode="6"
    android:versionName="3.2">

    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="34" />

    <!-- 老系统（≤28）直接读写公共目录；29+ 走 MediaStore，不再需要写权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- 33+ 从媒体库读音频（含厂商录音） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 后台录音：前台服务 + 通知（33+ 通知权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 服务器同步（旧版只在 WebView 里发请求，权限是给原生同步客户端补的） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App 内扫码配对（运行时申请，只在打开扫码时用） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="voxnote"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".HomeActivity"
            android:label="voxnote"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection|density|fontScale"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 扫码配对：Web 控制台二维码 → pair.html 中转 → voxnote://pair?host=…&t=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voxnote" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- 录音前台服务：锁屏/切后台继续录 -->
        <service
            android:name=".v2.V2RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
